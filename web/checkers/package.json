{
  "name": "ppo-checkers-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:responsive": "playwright test e2e/game.spec.ts --project=chromium --grep \"horizontal overflow\"",
    "test:e2e:touch": "playwright test e2e/touch.spec.ts --project=touch-chromium",
    "test:e2e:a11y": "playwright test e2e/game.spec.ts --project=chromium --grep \"WCAG\"",
    "test:e2e:visual": "playwright test e2e/visual.spec.ts --project=chromium",
    "measure:production": "node scripts/measure_production.mjs",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.e2e.json --pretty false"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "jsdom": "25.0.1",
    "playwright-core": "1.61.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.65.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
